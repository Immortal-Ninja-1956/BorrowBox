# Database Connection URL (Supabase/PostgreSQL)
# Ensure ?sslmode=require is appended for secure TLS/SSL database connections in production
DATABASE_URL="postgresql://postgres:[password]@[host]:6543/postgres?sslmode=require"

# Supabase Client Environment Variables
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Cloudinary Storage credentials for image uploads
CLOUDINARY_URL="cloudinary://your_key:your_secret@your_cloud_name"

# Optional:
RESEND_API_KEY=re_your_api_key
